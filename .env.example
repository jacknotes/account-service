# 复制为 .env 并填写实际值，.env 已被 .gitignore 排除
# 生产环境务必使用随机强口令，不要沿用示例值

# ---- 必填 ----
# JWT 签名密钥（至少 32 位随机字符串，可用 openssl rand -base64 48 生成）
JWT_SECRET=your-random-secret-at-least-32-chars

# MySQL 5.7
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=account_service
MYSQL_USER=account
MYSQL_PASSWORD=

# ---- 可选 ----
# PORT=8081
# ALLOWED_ORIGINS=*
# 反向代理 IP 列表（逗号分隔），如 Nginx/Traefik 后部署必须填写，否则限流按代理 IP 计数
# TRUSTED_PROXIES=127.0.0.1
# HTTP 超时
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s
